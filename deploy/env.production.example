# Production .env for EC2. Copy to .env on the server, then:
#   php artisan key:generate
#
# Never commit the real .env — nginx blocks dotfiles, but keep it out of git too.

APP_NAME="Atlantic Ave Cruisers"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://atlanticavecruisers.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Inertia SSR stays off — there is no resources/js/ssr.tsx entry point.
INERTIA_SSR_ENABLED=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------
# SQLite is fine for the marketing site: no user data yet, and sessions/cache/
# queue are low volume. The file lives at database/database.sqlite.
DB_CONNECTION=sqlite

# When RDS arrives, comment the line above and use these instead. Create the
# instance in the same VPC/AZ as the EC2 box and restrict its security group
# to the instance's SG — never to 0.0.0.0/0.
# DB_CONNECTION=mysql
# DB_HOST=your-instance.abc123.us-east-1.rds.amazonaws.com
# DB_PORT=3306
# DB_DATABASE=atlantic
# DB_USERNAME=atlantic
# DB_PASSWORD=

# --- No database required -------------------------------------------------
# The public site stores nothing: the club sign-up is emailed straight to the
# shop, so sessions, cache and the queue all run off the filesystem and no
# database is touched at all.
#
# Caveat: the auth scaffolding (/login, /register, /dashboard, /settings) DOES
# need a users table. Those pages will error until a database exists — nothing
# on the public site links to them. To bring them back, create the database,
# set the DB_* values above, run `php artisan migrate`, and switch these three
# back to `database`.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12

FILESYSTEM_DISK=local

# --- Mail (Gmail SMTP) ----------------------------------------------------
# MAIL_PASSWORD is a Google *App Password*, not the account password — the
# normal password will be rejected. Generating one requires 2-Step
# Verification to be switched on for the account first:
#   https://myaccount.google.com/apppasswords
# Paste the 16 characters with no spaces.
#
# Port 587 uses STARTTLS, which is what MAIL_SCHEME=smtp selects. For implicit
# TLS instead, use MAIL_SCHEME=smtps with MAIL_PORT=465.
#
# MAIL_FROM_ADDRESS must match the account below (or one of its verified
# aliases) — Gmail rewrites the From header otherwise.
#
# Limits: a free Gmail account sends ~500 messages a day, Workspace ~2,000.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=atlantic.ave.cruisers@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="atlantic.ave.cruisers@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Swap to `log` to write mail into storage/logs instead of sending, which is
# useful while testing:
# MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
